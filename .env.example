# ──────────────────────────────────────────────
# SkyluxMovies — Environment Variables
# Add these in your Render dashboard
# ──────────────────────────────────────────────

# REQUIRED: Get free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# OPTIONAL: Lock API to external callers (n8n, etc). Leave blank = open
API_KEY=

# Auto-set by Render — do not change
# PORT=10000
